# ResumeLens: Frontend Environment Configuration
# Copy this file to .env and configure as needed.

# Base URL for the Spring Boot REST API (defaults to http://localhost:8080 if omitted)
VITE_API_BASE_URL=http://localhost:8080

# Optional: OAuth Client IDs for Google and GitHub Sign-In
# When unset, standard in-app OAuth credential input is used for dev and demo
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
