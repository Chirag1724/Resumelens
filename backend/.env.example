# ResumeLens — Backend Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
#
# How to load these variables:
#   Option A (recommended): Export in your shell before running the app.
#     Linux / macOS / Git Bash:  export DB_PASSWORD=yourpassword
#     Windows PowerShell:        $env:DB_PASSWORD = "yourpassword"
#   Option B: Configure in your IDE run configuration (IntelliJ: Run > Edit
#             Configurations > Environment Variables; VS Code: launch.json "env" block).
#
# Spring Boot reads OS environment variables natively — no extra library required.

# JDBC connection URL for MySQL.
# The default points to localhost:3306/resumelens, which is fine for local dev.
DB_URL=jdbc:mysql://localhost:3306/resumelens?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# MySQL username. Defaults to 'root' in application.yml if not set.
DB_USERNAME=root

# MySQL password. No default — application will fail to start if this is missing.
DB_PASSWORD=your_mysql_password_here

# JWT signing secret. Must be at least 256 bits (32+ characters). No default.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters
