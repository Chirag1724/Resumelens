# ResumeLens: Backend Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
#
# How to load these variables:
#   Automatic (Default): Just create .env in backend/ with your values.
#   Spring Boot 3 natively loads this .env file on startup via spring.config.import
#   in application.yml — zero manual shell exports required!
#
#   Alternatively: You can still export in your shell or IDE run configurations.
#   In production (Docker/cloud), real OS environment variables take precedence.

# JDBC connection URL for PostgreSQL (Supabase Session pooler).
# Replace HOST_FROM_DASHBOARD with the Session pooler host shown in the
# Connect panel of your Supabase project dashboard.
# The Session pooler runs on port 5432 and requires sslmode=require.
# For local development use: jdbc:postgresql://localhost:5432/resumelens
DB_URL=jdbc:postgresql://HOST_FROM_DASHBOARD:5432/postgres?sslmode=require

# Supabase PostgreSQL username (Session pooler format: postgres.<project_ref>).
# Find your project ref in the Supabase dashboard URL or Project Settings.
DB_USERNAME=postgres.YOUR_PROJECT_REF

# Database password. No default, the application will fail to start if this is missing.
DB_PASSWORD=your_database_password_here

# JWT signing secret. Must be at least 256 bits (32+ characters). No default.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters

# Allowed CORS origins (comma-separated list, whitespace trimmed).
# Defaults to http://localhost:5173 if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Enable or disable Swagger UI (/swagger-ui/index.html) and OpenAPI docs (/v3/api-docs).
# Defaults to false in production. Set to true to enable interactive API documentation.
SWAGGER_ENABLED=false

# Guest data retention period in days.
# Resumes without an associated user older than this threshold are purged daily.
# Defaults to 7 if unset.
RETENTION_DAYS=7

