# ResumeLens: Docker Compose Environment Variables
# Copy this file to .env and configure values before starting containers.
# .env is gitignored and must never be committed.

# PostgreSQL database password for the database and backend services
POSTGRES_PASSWORD=your_postgres_password_here

# JWT signing secret (minimum 32 characters)
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Allowed CORS origins (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

